{
  "name": "@sergeyhorse/forge",
  "version": "0.1.0",
  "description": "Headless + styled React UI kit for dashboards",
  "license": "MIT",
  "author": "Sergey Horse",
  "homepage": "https://github.com/sergeyhorse1/forge-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergeyhorse1/forge-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/sergeyhorse1/forge-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "datagrid",
    "data-table",
    "virtualization",
    "filter-builder",
    "tailwindcss",
    "radix-ui",
    "accessibility",
    "dashboard",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "verify-styles": "node scripts/verify-dist-styles.mjs",
    "build:verify": "vite build && node scripts/verify-dist-styles.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.stories.json --noEmit"
  },
  "peerDependencies": {
    "date-fns": "^4",
    "radix-ui": "^1",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "date-fns": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.9",
    "@storybook/react-vite": "10.4.6",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.9",
    "date-fns": "^4",
    "jsdom": "29.1.1",
    "lucide-react": "^1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "0.0.0",
    "tailwindcss": "4.3.1",
    "vite": "8.1.0",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "react-day-picker": "~10.0.1",
    "tailwind-merge": "3.6.0"
  }
}
