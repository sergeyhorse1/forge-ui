{
  "name": "@sergeyhorse/forge",
  "version": "0.0.0",
  "description": "Headless + styled React UI kit for dashboards",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "radix-ui": "^1",
    "lucide-react": "^1",
    "date-fns": "^4"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.9",
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "date-fns": "^4",
    "lucide-react": "^1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.0",
    "vite-plugin-dts": "5.0.3"
  }
}
